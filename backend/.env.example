DATABASE_URL=sqlite:///./wanderer_v2.db
# Generate your own key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-your-own-random-secret
# PostgreSQL alternative (create an empty database first):
# DATABASE_URL=postgresql://wanderer_user:wanderer_password@localhost:5432/wanderer_db
REDIS_URL=redis://localhost:6379
HUGGINGFACE_API_KEY=
HF_MODEL_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=CohereLabs/c4ai-command-r-08-2024
CORS_ORIGINS=["http://localhost:5173"]
AUTO_CREATE_SCHEMA=true
# TinyFish stays disabled until the account and each source have been verified.
# For local encrypted storage: backend/venv/bin/python scripts/store-tinyfish-key.py
# Production may supply TINYFISH_API_KEY through the hosting secret store.
TINYFISH_API_KEY=
TINYFISH_DISCOVERY_VERIFIED=false
TINYFISH_BILLING_VERIFIED=false
TINYFISH_LIVE_SOURCES=[]
TINYFISH_CUSTOM_STEP_LIMIT=false
# Integer thousandths of USD: 9000 = $9 lifetime; 16 = $0.016 per step.
TINYFISH_BUDGET_MUSD=9000
TINYFISH_STEP_COST_MUSD=16
