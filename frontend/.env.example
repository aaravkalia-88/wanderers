# Deployed FastAPI base URL, including /api/v1. Leave empty for the local Vite proxy.
# This is public build-time configuration; never put server secrets in VITE_* values.
VITE_API_BASE_URL=
# Optional public deployment key; overrides encrypted local configuration.
# CARTO browser tile requests expose this value. Restart Vite after edits.
VITE_CARTO_API_KEY=
# Local AES-256-GCM ciphertext; requires the ignored .runtime/carto-env.key.
# Never put the encryption key in a VITE_* variable or frontend/public/.
CARTO_API_KEY_ENCRYPTED=
# OSRM-compatible driving route service.
VITE_ROUTING_URL=https://router.project-osrm.org
