# Deployed FastAPI base URL, including /api/v1. Leave empty for the local Vite proxy.
# This is public build-time configuration; never put server secrets in VITE_* values.
VITE_API_BASE_URL=
# Copy to .env.local and provide your CARTO tile key. Restart Vite after edits.
VITE_CARTO_API_KEY=
# OSRM-compatible driving route service.
VITE_ROUTING_URL=https://router.project-osrm.org
